{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@entities/*": [
        "./types/entities/*"
      ],
      "@collections/*": [
        "./types/collections/*"
      ],
      "@utils/*": [ "./utils/*"],
      "@services/*": [ "./services/*"],
      "@components/*": [ "./components/*"],
      "@styles/*": [ "./styles/*"],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "components/events/results-table"
  ],
  "exclude": [
    "node_modules"
  ]
}